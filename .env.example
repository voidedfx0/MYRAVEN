# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets belong in hosting environment variables.
# Never prefix private keys, service-role keys, or signing secrets with NEXT_PUBLIC_.

# Stripe test-only card checkout (never expose these as NEXT_PUBLIC_ variables)
MYRAVEN_MODE=test
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
